load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//fable/private:providers",
        "//fable/private:rules",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = [":nuget"],
)

bzl_library(
    name = "nuget",
    srcs = ["nuget.bzl"],
)
