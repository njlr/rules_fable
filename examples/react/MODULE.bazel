bazel_dep(name = "aspect_rules_js", version = "3.2.1")
bazel_dep(name = "aspect_rules_webpack", version = "0.17.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_dotnet", version = "0.21.5")
bazel_dep(name = "rules_fable", version = "0.0.0")
bazel_dep(name = "rules_nodejs", version = "6.7.4")

local_path_override(
    module_name = "rules_fable",
    path = "../..",
)

main_extension = use_extension("//paket/deps:paket.main_extension.bzl", "main_extension")
use_repo(main_extension, "paket.main")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(dotnet_version = "10.0.100")
use_repo(dotnet, "dotnet_toolchains")

fable_toolchains = use_extension("@rules_fable//fable:extensions.bzl", "toolchains")
fable_toolchains.toolchain(fable_version = "5.1.0")
use_repo(fable_toolchains, "fable_toolchains")

register_toolchains("@dotnet_toolchains//:all")

register_toolchains("@fable_toolchains//:fable_toolchain")
