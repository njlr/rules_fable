bazel_dep(name = "aspect_rules_js", version = "3.2.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_dotnet", version = "0.20.5")
bazel_dep(name = "rules_fable", version = "0.0.0")
bazel_dep(name = "rules_nodejs", version = "6.7.4")
bazel_dep(name = "rules_python", version = "0.23.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
)
use_repo(python, "pythons_hub")

register_toolchains("@pythons_hub//:all")

local_path_override(
    module_name = "rules_fable",
    path = "../..",
)

main_extension = use_extension("//paket/deps:paket.main_extension.bzl", "main_extension")
use_repo(main_extension, "paket.main")

fable_toolchains = use_extension("@rules_fable//fable:extensions.bzl", "toolchains")
fable_toolchains.toolchain(fable_version = "4.29.0")
use_repo(fable_toolchains, "fable_toolchains")

register_toolchains("@fable_toolchains//:fable_toolchain")
