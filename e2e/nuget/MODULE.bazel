bazel_dep(name = "aspect_rules_js", version = "3.2.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_dotnet", version = "0.20.5")
bazel_dep(name = "rules_fable", version = "0.0.0")
bazel_dep(name = "rules_nodejs", version = "6.7.4")

local_path_override(
    module_name = "rules_fable",
    path = "../..",
)

main_extension = use_extension("//paket/deps:paket.main_extension.bzl", "main_extension")
use_repo(main_extension, "paket.main")

fable_nuget = use_extension("@rules_fable//fable:extensions.bzl", "nuget")
use_repo(
    fable_nuget,
    "nuget.fable.v4.29.0",
    "rules_fable_nuget_packages",
)
